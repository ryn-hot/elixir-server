ARG RUST_IMAGE=rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2
ARG RUNTIME_IMAGE=debian:bookworm-20260623-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df
FROM ${RUST_IMAGE} AS builder

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY vendor ./vendor
COPY docs ./docs
COPY extensions ./extensions
COPY elixir-server ./elixir-server
RUN cargo build --locked --release -p elixir-server --bin elixir-live-egress-worker \
    && strip /src/target/release/elixir-live-egress-worker

FROM ${RUNTIME_IMAGE}

ARG RUST_IMAGE
ARG RUNTIME_IMAGE

LABEL org.opencontainers.image.title="Elixir Live egress worker" \
      org.opencontainers.image.description="Session-isolated authenticated upstream worker for protected Live playback" \
      org.opencontainers.image.vendor="Elixir" \
      org.opencontainers.image.base.name="${RUNTIME_IMAGE}" \
      org.elixir.build.rust-image="${RUST_IMAGE}"

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY --from=builder --chown=65532:65532 \
    /src/target/release/elixir-live-egress-worker \
    /usr/local/bin/elixir-live-egress-worker

USER 65532:65532
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/elixir-live-egress-worker"]
